{
  "name": "@siod/react-dates",
  "version": "22.0.0",
  "description": "A maintained React 18+ fork of react-dates using Luxon",
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.js",
  "module": "./esm/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./constants": {
      "import": {
        "types": "./esm/constants.d.ts",
        "default": "./esm/constants.js"
      },
      "require": {
        "types": "./lib/constants.d.ts",
        "default": "./lib/constants.js"
      }
    },
    "./initialize": {
      "import": {
        "types": "./esm/initialize.d.ts",
        "default": "./esm/initialize.js"
      },
      "require": {
        "types": "./lib/initialize.d.ts",
        "default": "./lib/initialize.js"
      }
    },
    "./css": "./lib/css/_datepicker.css",
    "./lib/css/_datepicker.css": "./lib/css/_datepicker.css",
    "./lib/theme/DefaultTheme": null,
    "./lib/theme/DefaultTheme.js": null,
    "./esm/theme/DefaultTheme": null,
    "./esm/theme/DefaultTheme.js": null,
    "./lib/internal/styles/defaultStyleTokens": null,
    "./lib/internal/styles/defaultStyleTokens.js": null,
    "./esm/internal/styles/defaultStyleTokens": null,
    "./esm/internal/styles/defaultStyleTokens.js": null,
    "./lib/*.js": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./esm/*.js": {
      "types": "./esm/*.d.ts",
      "default": "./esm/*.js"
    },
    "./esm/*": {
      "types": "./esm/*.d.ts",
      "default": "./esm/*.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "./initialize.js",
    "./lib/initialize.js",
    "./esm/initialize.js"
  ],
  "files": [
    "lib",
    "esm",
    "index.js",
    "constants.js",
    "initialize.js",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:metadata && npm run build:css && npm run build:types",
    "build:cjs": "vite build --mode cjs",
    "build:esm": "vite build --mode esm",
    "build:metadata": "node scripts/write-module-metadata.mjs",
    "build:css": "node scripts/build-css.mjs",
    "build:types": "tsc -p tsconfig.build.json && node scripts/sync-declarations.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:types:packed": "node scripts/test-packed-types.mjs",
    "verify:typescript-gate0": "node scripts/verify-typescript-gate0.mjs",
    "lint": "eslint .",
    "check:deps": "knip --dependencies --no-config-hints",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "preview": "vite preview",
    "prepublishOnly": "npm run lint && npm run test:coverage && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siod/react-dates.git"
  },
  "author": "Maja Wichrowska <maja.wichrowska@airbnb.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/siod/react-dates/issues"
  },
  "homepage": "https://github.com/siod/react-dates#readme",
  "dependencies": {
    "@types/luxon": "^3.7.6"
  },
  "peerDependencies": {
    "@types/react": "^18.3.1 || ^19.0.0",
    "luxon": "^3.7.2",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/react-vite": "^10.5.8",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "lightningcss": "^1.33.0",
    "luxon": "^3.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.2.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "browserslist": [
    ">0.5%",
    "not dead",
    "not IE 11"
  ]
}
