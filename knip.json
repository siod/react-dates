{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "index.js",
    "constants.js",
    "initialize.js",
    "src/index.{js,ts}",
    "src/constants.{js,ts}",
    "src/initialize.{js,ts}",
    "scripts/*.mjs",
    "test/**/*.test.{js,jsx,ts,tsx}",
    "test/browser-fixtures/**/*.spec.{js,jsx,mjs,ts,tsx}",
    ".storybook/*.{js,mjs}"
  ],
  "project": [
    "src/**/*.{js,jsx,ts,tsx}",
    "scripts/**/*.{js,jsx,mjs,ts,tsx}",
    "test/**/*.{js,jsx,mjs,ts,tsx}",
    "stories/**/*.{js,jsx,mjs,ts,tsx}",
    "examples/**/*.{js,jsx,mjs,ts,tsx}",
    ".storybook/**/*.{js,jsx,mjs,ts,tsx}"
  ],
  "ignoreDependencies": [
    "lightningcss",
    "@storybook/addon-a11y"
  ],
  "ignore": [
    ".eslintrc",
    "**/.eslintrc",
    "lib/**",
    "esm/**",
    "coverage/**",
    "storybook-static/**",
    "playwright-report/**",
    "test-results/**",
    "fixtures/**"
  ]
}
